{
  "permissions": {
    "allow": [
      "Bash(bun outdated:*)",
      "Bash(bun update:*)",
      "Bash(bunx biome:*)",
      "Bash(head:*)",
      "Bash(find:*)",
      "Bash(bun run build:*)",
      "Bash(grep:*)",
      "Bash(tee:*)",
      "Bash(while read f)",
      "Bash(do grep -q \"^import.*PageLayout\\\\|^import.*Note\\\\|^import.*Pagination\" \"$f\")",
      "Bash(echo:*)",
      "Bash(done)",
      "Bash(ls:*)",
      "Bash(for file in SocialList.astro AIChatbot.astro Search.astro ThemeToggle.astro OramaSearch.astro SeriesPanel.astro)",
      "Bash(do head -3 \"$file\")",
      "Bash(for file in TOC.astro Masthead.astro)",
      "Bash(timeout 120 bun run build:*)",
      "Bash(1)"
    ],
    "deny": []
  }
}
