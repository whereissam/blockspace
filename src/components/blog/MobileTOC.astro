---
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Only show TOC if there are headings
if (!headings || headings.length === 0) {
	return null;
}
---

<!-- Mobile TOC Button - only visible on mobile -->
<div class="md:hidden relative">
  <button
    id="mobile-toc-toggle"
    class="flex h-8 w-8 items-center justify-center rounded-lg bg-bgColor border border-special-lighter text-accent-base hover:text-accent-two hover:bg-special-light transition-all duration-200"
    aria-label="Table of Contents"
    aria-expanded="false"
  >
    <svg
      class="h-4 w-4 transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <!-- Mobile TOC Dropdown -->
  <div
    id="mobile-toc-dropdown"
    class="absolute top-12 right-0 w-72 max-w-[90vw] opacity-0 invisible transform translate-y-2 transition-all duration-300 ease-out pointer-events-none z-40"
  >
    <div class="bg-bgColor border border-special-lighter rounded-lg drop-shadow-xl p-4 max-h-80 overflow-y-auto">
      <div class="flex items-center justify-between mb-3">
        <div class="text-sm font-semibold text-accent-base">Table of Contents</div>
        <button
          id="mobile-toc-close"
          class="text-textColor hover:text-accent-base transition-colors"
          aria-label="Close Table of Contents"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
      
      <nav class="space-y-2">
        {headings.map((heading) => (
          <a
            href={`#${heading.slug}`}
            class="block text-sm text-textColor hover:text-accent-base transition-colors duration-200 py-1 px-2 rounded hover:bg-special-light"
            style={`padding-left: ${(heading.depth - 1) * 0.75}rem`}
          >
            <span class="truncate block">{heading.text}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggleButton = document.getElementById("mobile-toc-toggle") as HTMLButtonElement | null;
    const dropdown = document.getElementById("mobile-toc-dropdown") as HTMLDivElement | null;
    const closeButton = document.getElementById("mobile-toc-close") as HTMLButtonElement | null;

    if (!toggleButton || !dropdown || !closeButton) {
      return;
    }

    function openDropdown() {
      dropdown!.classList.remove("opacity-0", "invisible", "translate-y-2", "pointer-events-none");
      dropdown!.classList.add("opacity-100", "visible", "translate-y-0", "pointer-events-auto");
      toggleButton!.setAttribute("aria-expanded", "true");
    }

    function closeDropdown() {
      dropdown!.classList.add("opacity-0", "invisible", "translate-y-2", "pointer-events-none");
      dropdown!.classList.remove("opacity-100", "visible", "translate-y-0", "pointer-events-auto");
      toggleButton!.setAttribute("aria-expanded", "false");
    }

    // Toggle dropdown
    toggleButton.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = toggleButton!.getAttribute("aria-expanded") === "true";

      if (isExpanded) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Close button
    closeButton.addEventListener("click", (e) => {
      e.stopPropagation();
      closeDropdown();
    });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Element;
      if (!dropdown!.contains(target) && !toggleButton!.contains(target)) {
        closeDropdown();
      }
    });

    // Close when clicking on a TOC link
    const tocLinks = dropdown!.querySelectorAll("a[href^='#']");
    tocLinks.forEach(link => {
      link.addEventListener("click", () => {
        closeDropdown();
      });
    });

    // Close on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeDropdown();
      }
    });
  });
</script>

<style>
  /* Custom scrollbar for the TOC dropdown */
  #mobile-toc-dropdown .max-h-80 {
    scrollbar-width: thin;
    scrollbar-color: var(--theme-color-300) var(--theme-color-100);
  }

  #mobile-toc-dropdown .max-h-80::-webkit-scrollbar {
    width: 6px;
  }

  #mobile-toc-dropdown .max-h-80::-webkit-scrollbar-track {
    background: var(--theme-color-100);
    border-radius: 3px;
  }

  #mobile-toc-dropdown .max-h-80::-webkit-scrollbar-thumb {
    background: var(--theme-color-300);
    border-radius: 3px;
  }

  #mobile-toc-dropdown .max-h-80::-webkit-scrollbar-thumb:hover {
    background: var(--theme-color-400);
  }
</style>