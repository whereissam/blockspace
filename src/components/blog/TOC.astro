---
import { Icon } from "astro-icon/components";
import TOCHeading from "@/components/blog/TOCHeading.astro";
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<div class="rounded-lg shadow-lg bg-bgColor border border-color-200 overflow-hidden">
	<!-- Header -->
	<div class="flex items-center gap-2 px-4 py-3 bg-gradient-to-r from-accent-base/5 to-accent-two/5 border-b border-color-150">
		<Icon aria-hidden="true" class="h-5 w-5 text-accent-base" focusable="false" name="hugeicons:menu-03" />
		<div class="font-semibold text-accent-base">Table of Contents</div>
	</div>
	
	<!-- Content -->
	<div class="max-h-[50vh] overflow-y-auto" id="toc-content">
		<nav class="p-4">
			<ul class="space-y-1 text-sm" id="toc-list">
				{toc.map((heading) => (
					<TOCHeading heading={heading} />
				))}
			</ul>
		</nav>
	</div>
</div>

<script>
	document.addEventListener('astro:page-load', () => {
		// Smooth scrolling for TOC links
		const tocLinks = document.querySelectorAll('[data-toc-link]');
		const headings = document.querySelectorAll('h2, h3, h4, h5, h6[id]');
		
		// Add smooth scrolling
		tocLinks.forEach(link => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const targetId = link.getAttribute('data-toc-link');
				const targetElement = targetId ? document.getElementById(targetId) : null;
				
				if (targetElement) {
					const headerOffset = 120; // Account for fixed header + proper top positioning
					const elementPosition = targetElement.getBoundingClientRect().top;
					const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
					
					window.scrollTo({
						top: offsetPosition,
						behavior: 'smooth'
					});
					
					// Update active state
					updateActiveLink(link);
				}
			});
		});
		
		// Highlight active section on scroll
		function updateActiveLink(activeLink: Element | null = null) {
			tocLinks.forEach(link => {
				const linkElement = link as HTMLElement;
				linkElement.classList.remove('toc-active');
				// Remove active styles
				linkElement.style.backgroundColor = '';
				linkElement.style.color = '';
				linkElement.style.borderLeftColor = '';
				const dot = linkElement.querySelector('span');
				if (dot) dot.style.opacity = '0';
			});
			
			if (activeLink) {
				const activeLinkElement = activeLink as HTMLElement;
				activeLinkElement.classList.add('toc-active');
				// Add active styles
				activeLinkElement.style.backgroundColor = 'hsl(var(--theme-accent-base) / 0.1)';
				activeLinkElement.style.color = 'hsl(var(--theme-accent-base))';
				activeLinkElement.style.borderLeftColor = 'hsl(var(--theme-accent-base))';
				const dot = activeLinkElement.querySelector('span');
				if (dot) dot.style.opacity = '1';
				
				// Scroll TOC to keep active link visible at the top
				scrollTocToActiveLink(activeLinkElement);
			}
		}
		
		// Function to scroll TOC so active link is at the top
		function scrollTocToActiveLink(activeLink: HTMLElement | null) {
			const tocContent = document.getElementById('toc-content');
			if (tocContent && activeLink) {
				const linkRect = activeLink.getBoundingClientRect();
				const containerRect = tocContent.getBoundingClientRect();
				const relativeTop = linkRect.top - containerRect.top + tocContent.scrollTop;

				// Scroll to position the active link near the top with some padding
				tocContent.scrollTo({
					top: relativeTop - 20,
					behavior: 'smooth'
				});
			}
		}
		
		// Intersection Observer for active section detection
		const observerOptions = {
			rootMargin: '-120px 0px -75% 0px',
			threshold: [0, 0.1]
		};
		
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const id = entry.target.id;
					const correspondingLink = document.querySelector(`[data-toc-link="${id}"]`);
					if (correspondingLink) {
						updateActiveLink(correspondingLink);
					}
				}
			});
		}, observerOptions);
		
		// Observe all headings
		headings.forEach(heading => {
			if (heading.id) {
				observer.observe(heading);
			}
		});
		
	});
</script>

<style>
	.toc-item {
		position: relative;
	}
	
	.toc-active {
		font-weight: 600 !important;
	}
	
	.toc-active .absolute.left-0 {
		opacity: 1 !important;
		transform: translateY(-50%) scale(1.2);
	}
	
	/* Custom scrollbar for TOC */
	#toc-content {
		scrollbar-width: thin;
		scrollbar-color: hsl(var(--theme-accent-base) / 0.3) transparent;
	}
	
	#toc-content::-webkit-scrollbar {
		width: 4px;
	}
	
	#toc-content::-webkit-scrollbar-track {
		background: transparent;
	}
	
	#toc-content::-webkit-scrollbar-thumb {
		background-color: hsl(var(--theme-accent-base) / 0.3);
		border-radius: 2px;
	}
	
	#toc-content::-webkit-scrollbar-thumb:hover {
		background-color: hsl(var(--theme-accent-base) / 0.5);
	}
</style>
