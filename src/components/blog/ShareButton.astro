<style>
	.show {
		opacity: 1 !important;
		visibility: visible !important;
		transform: translateX(0) !important;
		pointer-events: auto !important;
	}

	#share-icon.rotated {
		transform: rotate(180deg);
	}

	/* Hide on very small screens to avoid overlap */
	@media (max-width: 480px) {
		#share-button-container {
			display: none;
		}
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		// Desktop elements
		const shareButton = document.getElementById("share-toggle");
		const shareDropdown = document.getElementById("share-dropdown");
		const shareIcon = document.getElementById("share-icon");
		const copyLinkButton = document.getElementById("copy-link");

		// Mobile elements
		const shareButtonMobile = document.getElementById("share-toggle-mobile");
		const shareDropdownMobile = document.getElementById("share-dropdown-mobile");
		const shareIconMobile = document.getElementById("share-icon-mobile");
		const copyLinkButtonMobile = document.getElementById("copy-link-mobile");

		// Desktop functionality
		if (shareButton && shareDropdown && shareIcon && copyLinkButton) {
			shareButton.addEventListener("click", () => {
				const isExpanded = shareButton.getAttribute("aria-expanded") === "true";
				
				if (isExpanded) {
					shareDropdown.classList.remove("show");
					shareIcon.classList.remove("rotated");
					shareButton.setAttribute("aria-expanded", "false");
				} else {
					shareDropdown.classList.add("show");
					shareIcon.classList.add("rotated");
					shareButton.setAttribute("aria-expanded", "true");
				}
			});

			copyLinkButton.addEventListener("click", async () => {
				await copyToClipboard(copyLinkButton);
			});
		}

		// Mobile functionality
		if (shareButtonMobile && shareDropdownMobile && shareIconMobile && copyLinkButtonMobile) {
			shareButtonMobile.addEventListener("click", () => {
				const isExpanded = shareButtonMobile.getAttribute("aria-expanded") === "true";
				
				if (isExpanded) {
					shareDropdownMobile.classList.remove("show");
					shareIconMobile.classList.remove("rotated");
					shareButtonMobile.setAttribute("aria-expanded", "false");
				} else {
					shareDropdownMobile.classList.add("show");
					shareIconMobile.classList.add("rotated");
					shareButtonMobile.setAttribute("aria-expanded", "true");
				}
			});

			copyLinkButtonMobile.addEventListener("click", async () => {
				await copyToClipboard(copyLinkButtonMobile);
			});
		}

		// Shared copy functionality
		async function copyToClipboard(button) {
			const url = button.getAttribute("data-url");
			if (!url) return;

			try {
				await navigator.clipboard.writeText(url);
				const originalText = button.querySelector("span")?.textContent;
				const span = button.querySelector("span");
				
				if (span) {
					span.textContent = "Copied!";
					setTimeout(() => {
						span.textContent = originalText || "Copy Link";
					}, 2000);
				}
			} catch (err) {
				console.error("Failed to copy link:", err);
			}
		}

		// Close dropdowns when clicking outside
		document.addEventListener("click", (event) => {
			const target = event.target as Element;
			
			// Close desktop dropdown
			if (shareButton && shareDropdown && shareIcon) {
				const desktopContainer = shareButton.closest("div");
				if (desktopContainer && !desktopContainer.contains(target)) {
					shareDropdown.classList.remove("show");
					shareIcon.classList.remove("rotated");
					shareButton.setAttribute("aria-expanded", "false");
				}
			}

			// Close mobile dropdown
			if (shareButtonMobile && shareDropdownMobile && shareIconMobile) {
				const mobileContainer = shareButtonMobile.closest("div");
				if (mobileContainer && !mobileContainer.contains(target)) {
					shareDropdownMobile.classList.remove("show");
					shareIconMobile.classList.remove("rotated");
					shareButtonMobile.setAttribute("aria-expanded", "false");
				}
			}
		});

		// Close dropdowns on escape key
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				if (shareButton && shareDropdown && shareIcon) {
					shareDropdown.classList.remove("show");
					shareIcon.classList.remove("rotated");
					shareButton.setAttribute("aria-expanded", "false");
				}
				if (shareButtonMobile && shareDropdownMobile && shareIconMobile) {
					shareDropdownMobile.classList.remove("show");
					shareIconMobile.classList.remove("rotated");
					shareButtonMobile.setAttribute("aria-expanded", "false");
				}
			}
		});
	});
</script>