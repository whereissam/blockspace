---
interface Props {
	title: string;
	url: string;
	description?: string;
}

const { title, url, description = "" } = Astro.props;
const currentUrl = new URL(url, Astro.site).toString();
---

<!-- Desktop share button -->
<div class="fixed left-4 top-1/2 -translate-y-1/2 z-40 hidden md:block">
	<button
		id="share-toggle"
		class="flex h-12 w-12 items-center justify-center rounded-full bg-bgColor border-2 border-accent-base/20 text-accent-base hover:text-accent-two hover:border-accent-base/40 drop-shadow-xl transition-all duration-300 hover:scale-105 shadow-lg"
		aria-label="Share this post"
		aria-expanded="false"
	>
		<span class="absolute inset-0 rounded-full bg-special-lighter flex items-center justify-center" aria-hidden="true">
			<svg
				id="share-icon"
				class="h-5 w-5 transition-transform duration-300"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="M16 6 12 2 8 6" stroke-linecap="round" stroke-linejoin="round"></path>
				<path d="m12 2 0 15" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
	</button>

	<div 
		id="share-dropdown" 
		class="absolute left-16 top-0 w-48 opacity-0 invisible transform -translate-x-2 transition-all duration-300 ease-out pointer-events-none"
	>
		<div class="bg-bgColor border border-special-lighter rounded-lg drop-shadow-xl p-2 space-y-1">
			<button
				id="copy-link"
				class="flex items-center gap-3 w-full px-3 py-2 text-sm font-medium text-textColor hover:text-accent-base hover:bg-special-light rounded-md transition-all duration-200 hover:translate-x-1"
				data-url={currentUrl}
				aria-label="Copy link to clipboard"
			>
				<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke-linecap="round" stroke-linejoin="round"></path>
					<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<span>Copy Link</span>
			</button>

			<a
				href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-3 w-full px-3 py-2 text-sm font-medium text-textColor hover:text-accent-base hover:bg-special-light rounded-md transition-all duration-200 hover:translate-x-1"
				aria-label="Share on Facebook"
