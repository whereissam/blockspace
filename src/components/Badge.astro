---
const { variant = "default", showHash = true, title } = Astro.props;

const badgeClasses = {
	base: "inline-flex items-center gap-0.5 rounded-(--ds-radius-sm) px-2 py-0.5 text-(--ds-font-label) font-semibold leading-none tracking-(--ds-tracking-wide) uppercase transition-colors duration-(--ds-duration-fast)",
	variants: {
		default: "bg-color-100 text-textColor hover:bg-color-200",
		accent: "bg-color-100 text-accent hover:bg-color-200",
		"accent-base": "bg-(--ds-brand) text-white",
		"accent-one": "bg-(--ds-brand-tint) text-(--ds-brand)",
		"accent-two": "border border-(--ds-brand) text-(--ds-brand) hover:bg-(--ds-brand) hover:text-white",
		muted: "bg-color-100 text-textColor hover:bg-(--ds-brand) hover:text-white",
		outline: "border border-color-200 text-textColor hover:border-(--ds-brand) hover:text-(--ds-brand)",
		inactive: "text-lighter bg-color-75",
	},
};

const variantClasses = badgeClasses.variants[variant as keyof typeof badgeClasses.variants];
---

<span class={`${badgeClasses.base} ${variantClasses}`}>
	{showHash && <span>#</span>}
	{title}
	<slot />
</span>
