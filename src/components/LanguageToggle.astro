---
import { Icon } from "astro-icon/components";

// Simple path-based locale detection and path generation
const currentPath = Astro.url.pathname;
const isZhTW = currentPath.startsWith('/zh-TW');
const isEn = currentPath.startsWith('/en');

// Get the base path without language prefix
const basePath = currentPath.replace(/^\/(?:en|zh-TW)/, '') || '/';

// Generate paths for both languages
const enPath = `/en${basePath}`;
const zhPath = `/zh-TW${basePath}`;

const languages = [
  { 
    code: 'en', 
    name: 'English',
    flag: '🇺🇸',
    path: enPath,
    active: isEn
  },
  { 
    code: 'zh-TW', 
    name: '繁體中文',
    flag: '🇹🇼', 
    path: zhPath,
    active: isZhTW
  }
];

const currentLang = languages.find(lang => lang.active);
---

<div class="relative group" style="position: relative; z-index: 1000;">
  <button
    class="flex h-8 w-8 items-center justify-center rounded-lg bg-color-100 hover:bg-accent-base/10 text-accent-base transition-colors"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
    id="language-toggle"
  >
    <Icon name="hugeicons:globe-02" class="h-4 w-4" />
  </button>
  
  <div 
    class="absolute right-0 top-full mt-2 w-36 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl hidden"
    style="z-index: 9999;"
    id="language-dropdown"
  >
    {languages.map((lang) => (
      <a
        href={lang.path}
        class={`block px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors first:rounded-t-lg last:rounded-b-lg ${
          lang.active ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 font-medium' : 'text-gray-700 dark:text-gray-300'
        }`}
      >
        <div class="flex items-center gap-2">
          <span class="text-xs">{lang.flag}</span>
          <span>{lang.name}</span>
          {lang.active && <span class="ml-auto text-blue-600 dark:text-blue-400">✓</span>}
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('language-toggle');
    const dropdown = document.getElementById('language-dropdown');
    
    if (toggle && dropdown) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isVisible = !dropdown.classList.contains('hidden');
        
        if (isVisible) {
          dropdown.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          dropdown.classList.remove('hidden');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', () => {
        dropdown.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    } else {
      console.error('Language toggle elements not found');
    }
  });
</script>