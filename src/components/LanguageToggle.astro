---
import { Icon } from "astro-icon/components";

// Simple path-based locale detection and path generation
const currentPath = Astro.url.pathname;
const isZhTW = currentPath.startsWith("/zh-TW");
const isZhCN = currentPath.startsWith("/zh-CN");
const isEn = currentPath.startsWith("/en");

// Get the base path without language prefix
const basePath = currentPath.replace(/^\/(?:en|zh-TW|zh-CN)/, "") || "/";

// Generate paths for all languages
const enPath = `/en${basePath}`;
const zhTWPath = `/zh-TW${basePath}`;
const zhCNPath = `/zh-CN${basePath}`;

const languages = [
	{
		code: "en",
		name: "English",
		flag: "🇺🇸",
		path: enPath,
		active: isEn,
	},
	{
		code: "zh-TW",
		name: "繁體中文",
		flag: "🇹🇼",
		path: zhTWPath,
		active: isZhTW,
	},
	{
		code: "zh-CN",
		name: "简体中文",
		flag: "🇨🇳",
		path: zhCNPath,
		active: isZhCN,
	},
];
---

<div class="relative group">
  <button
    class="language-toggle flex h-8 w-8 items-center justify-center rounded-lg bg-color-100 hover:bg-accent-base/10 text-accent-base transition-colors"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
    style="-webkit-user-select: none; -webkit-touch-callout: none;"
  >
    <Icon name="hugeicons:globe-02" class="h-4 w-4" />
  </button>

  <div
    class="language-dropdown fixed top-16 right-2 md:absolute md:right-0 md:top-full mt-2 w-40 bg-bgColor border border-special-lighter rounded-lg shadow-xl z-[9999] hidden"
  >
    {
      languages.map((lang) => (
        <a
          href={lang.path}
          class={`block px-3 py-2 text-sm hover:bg-special-light transition-colors first:rounded-t-lg last:rounded-b-lg ${
            lang.active
              ? "bg-accent-base/10 text-accent-base font-medium"
              : "text-textColor"
          }`}
        >
          <div class="flex items-center gap-2">
            <span class="text-xs">{lang.flag}</span>
            <span>{lang.name}</span>
            {lang.active && <span class="ml-auto text-accent-base">✓</span>}
          </div>
        </a>
      ))
    }
  </div>
</div>

<script>
  function toggleLanguageDropdown(event: Event) {
    event.preventDefault();
    event.stopPropagation();

    const button = event.currentTarget as HTMLElement;
    const dropdown = button.parentElement?.querySelector(".language-dropdown");
    if (!dropdown) return;

    const willShow = dropdown.classList.contains("hidden");
    dropdown.classList.toggle("hidden");
    button.setAttribute("aria-expanded", willShow ? "true" : "false");
  }

  // Wire up toggle buttons on every navigation (DOM is swapped by the router).
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".language-toggle").forEach((toggle) => {
      toggle.addEventListener("click", toggleLanguageDropdown);
    });
  });

  // Close any open dropdown when clicking outside. Registered once (module
  // scripts run a single time), so it never accumulates across navigations.
  document.addEventListener("click", (e) => {
    document.querySelectorAll(".language-toggle").forEach((toggle) => {
      const dropdown = toggle.parentElement?.querySelector(".language-dropdown");
      if (
        dropdown &&
        !toggle.contains(e.target as Node) &&
        !dropdown.contains(e.target as Node)
      ) {
        dropdown.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
