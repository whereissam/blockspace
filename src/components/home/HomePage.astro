---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Note from "@/components/note/Note.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getNotesByLanguage, getPostsByLanguage } from "@/data/post";
import { collectionDateSort } from "@/utils/date";
import { ui, type Locale } from "@/i18n/ui";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];

const DEFAULT_IMAGE = "/cover.png";

function getPostUrl(post: CollectionEntry<"post">): string {
	const pathSegments = post.id.split("/");
	const postLanguage = pathSegments[0]?.toLowerCase() ?? "en";
	const slug = pathSegments.slice(1).join("/");
	const langMap: Record<string, string> = { "zh-tw": "zh-TW", "zh-cn": "zh-CN", en: "en" };
	return `/${langMap[postLanguage] ?? "en"}/posts/${slug}/`;
}

function getPostImage(post: CollectionEntry<"post">): string {
	if (post.data.coverImage?.src) {
		return typeof post.data.coverImage.src === "string"
			? post.data.coverImage.src
			: (post.data.coverImage.src as any).src || DEFAULT_IMAGE;
	}
	return DEFAULT_IMAGE;
}

// Posts
const allPosts = await getPostsByLanguage(lang);
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];

const heroPost = allPostsByDate[0];
const sidebarPosts = allPostsByDate.slice(1, 5);
const remainingPosts = allPostsByDate.slice(5, 17);

// Notes
const allNotes = lang === "en"
	? await getCollection("note")
	: await getNotesByLanguage(lang);
const latestNotes = allNotes.sort(collectionDateSort).slice(0, 2);
---

<Base meta={{ title: t.homeTitle, description: t.homeDescription }}>
  <h1 class="sr-only">{t.homeSrTitle}</h1>

  {heroPost ? (
    <!-- Hero Section: featured post + sidebar list -->
    <section class="mt-[-100vh] pt-[100vh]">
      <div class="grid grid-cols-1 gap-[var(--ds-space-xl)] lg:grid-cols-12">

        <!-- Featured Post (hero) -->
        <a href={getPostUrl(heroPost)} data-astro-prefetch class="group lg:col-span-7">
          <div class="ds-img aspect-[16/9]">
            <img
              src={getPostImage(heroPost)}
              alt={heroPost.data.coverImage?.alt || heroPost.data.title}
              loading="eager"
            />
          </div>
          <div class="mt-[var(--ds-space-lg)]">
            {heroPost.data.tags?.[0] && (
              <span class="ds-tag">{heroPost.data.tags[0]}</span>
            )}
            <h2 class="ds-hero mt-[var(--ds-space-sm)] group-hover:text-[var(--ds-brand)] transition-colors duration-[var(--ds-duration-fast)]">
              {heroPost.data.title}
            </h2>
            <p class="mt-[var(--ds-space-sm)] line-clamp-2 ds-body text-lighter">
              {heroPost.data.description}
            </p>
            <FormattedDate
              class="ds-caption mt-[var(--ds-space-sm)] block"
              date={heroPost.data.publishDate}
              dateTimeOptions={{ year: "numeric", month: "long", day: "2-digit" }}
            />
          </div>
        </a>

        <!-- Sidebar Posts (stacked list) -->
        <div class="lg:col-span-5 flex flex-col">
          {sidebarPosts.map((post, i) => (
            <a
              href={getPostUrl(post)}
              data-astro-prefetch
              class:list={[
                "group flex gap-[var(--ds-space-md)] py-[var(--ds-space-lg)]",
                i > 0 && "border-t border-color-150",
              ]}
            >
              <div class="ds-img h-20 w-28 shrink-0">
                <img
                  src={getPostImage(post)}
                  alt={post.data.coverImage?.alt || post.data.title}
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col justify-center min-w-0">
                {post.data.tags?.[0] && (
                  <span class="ds-tag">{post.data.tags[0]}</span>
                )}
                <p class="ds-headline mt-[var(--ds-space-xs)] text-[length:var(--ds-font-body)] line-clamp-2 group-hover:text-[var(--ds-brand)] transition-colors duration-[var(--ds-duration-fast)]">
                  {post.data.title}
                </p>
                <FormattedDate
                  class="ds-caption mt-[var(--ds-space-xs)]"
                  date={post.data.publishDate}
                  dateTimeOptions={{ year: "numeric", month: "long", day: "2-digit" }}
                />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="mt-[-100vh] pt-[100vh]">
      <div class="text-center py-[var(--ds-space-3xl)]">
        {t.emptyMessage && <p class="ds-body mb-[var(--ds-space-md)]">{t.emptyMessage}</p>}
        {t.emptySubMessage && <p class="ds-caption">{t.emptySubMessage}</p>}
      </div>
    </section>
  )}

  <!-- Latest Posts Grid -->
  {remainingPosts.length > 0 && (
    <section class="mt-[var(--ds-space-3xl)]">
      <!-- Section header with divider -->
      <div class="flex items-center gap-[var(--ds-space-md)] mb-[var(--ds-space-xl)]">
        <h2 class="ds-subhead shrink-0">
          <a href={`/${lang}/posts/`}>{t.latestLabel}</a>
        </h2>
        <div class="ds-divider"></div>
      </div>

      <div class="grid grid-cols-1 gap-x-[var(--ds-space-xl)] gap-y-[var(--ds-space-2xl)] sm:grid-cols-2 lg:grid-cols-3">
        {remainingPosts.map((post) => (
          <a href={getPostUrl(post)} data-astro-prefetch class="group">
            <div class="ds-img aspect-[16/9]">
              <img
                src={getPostImage(post)}
                alt={post.data.coverImage?.alt || post.data.title}
                loading="lazy"
              />
            </div>
            <div class="mt-[var(--ds-space-md)]">
              {post.data.tags?.[0] && (
                <span class="ds-tag">{post.data.tags[0]}</span>
              )}
              <p class="ds-headline mt-[var(--ds-space-xs)] line-clamp-2 group-hover:text-[var(--ds-brand)] transition-colors duration-[var(--ds-duration-fast)]">
                {post.data.title}
              </p>
              <FormattedDate
                class="ds-caption mt-[var(--ds-space-xs)]"
                date={post.data.publishDate}
                dateTimeOptions={{ year: "numeric", month: "long", day: "2-digit" }}
              />
            </div>
          </a>
        ))}
      </div>

      <div class="mt-[var(--ds-space-xl)]">
        <a href={`/${lang}/posts/`} class="ds-btn-ghost">
          {t.viewAllPosts} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )}

  <!-- Notes Section -->
  {latestNotes.length > 0 && (
    <section class="mt-[var(--ds-space-3xl)] mb-[var(--ds-space-3xl)]">
      <div class="flex items-center gap-[var(--ds-space-md)] mb-[var(--ds-space-xl)]">
        <h2 class="ds-subhead shrink-0">
          <a href={`/${lang}/notes/`}>{t.notesLabel}</a>
        </h2>
        <div class="ds-divider"></div>
      </div>
      <div class="grid grid-cols-1 gap-[var(--ds-space-xl)] sm:grid-cols-2">
        {latestNotes.map((note: any) => (
          <div>
            <Note note={note} as="h4" isPreview />
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
