---
import OramaSearch from "@/components/OramaSearch.astro";
import AIChatbot from "@/components/AIChatbot.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LanguageToggle from "@/components/LanguageToggle.astro";
import { siteConfig, menuLinks } from "@/site.config";
import { Icon } from "astro-icon/components";

// Detect current language from URL
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith("/zh-TW")
	? "zh-TW"
	: currentPath.startsWith("/zh-CN")
		? "zh-CN"
		: "en";

// Simple translation function
const translations = {
	en: {
		"navigation.home": "Home",
		"navigation.about": "About",
		"navigation.blog": "Blog",
		"navigation.notes": "Notes",
	},
	"zh-TW": {
		"navigation.home": "首頁",
		"navigation.about": "關於",
		"navigation.blog": "部落格",
		"navigation.notes": "筆記",
	},
	"zh-CN": {
		"navigation.home": "首页",
		"navigation.about": "关于",
		"navigation.blog": "博客",
		"navigation.notes": "笔记",
	},
} as const;

type TranslationKey = keyof typeof translations.en;
const t = (key: string) => {
	const translationKey = key as TranslationKey;
	return translations[currentLang][translationKey] || key;
};
---

<header
  id="main-header"
  class="fixed left-0 top-0 z-30 w-full bg-bgColor/80 backdrop-blur-md border-b border-special-lighter/50 md:relative md:bg-transparent md:backdrop-blur-none md:border-none"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between">
      <!-- Logo Section -->
      <a
        aria-label={siteConfig.title}
        aria-current={Astro.url.pathname === "/" ||
        Astro.url.pathname === `/${currentLang}` ||
        Astro.url.pathname === `/${currentLang}/`
          ? "page"
          : false}
        class="group flex items-center gap-2.5"
        href={currentLang === "en" ? "/en" : `/${currentLang}`}
      >
        <img class="w-9 h-9" src="/brand.svg" alt="" />
        <strong
          class="hidden sm:block text-xl font-bold text-accent-base"
        >
          {siteConfig.title}
        </strong>
      </a>
      <!-- Desktop Navigation -->
      <nav
        aria-label="Main menu"
        class="hidden md:flex items-center gap-1"
        id="main-navigation-menu"
      >
        {
          menuLinks.map((link) => {
            const linkPath = `/${currentLang}${link.path}`;
            const isCurrentPage =
              Astro.url.pathname === linkPath ||
              (link.path === "/" &&
                (Astro.url.pathname === `/${currentLang}` ||
                  Astro.url.pathname === `/${currentLang}/`));

            return (
              <a
                aria-current={isCurrentPage ? "page" : false}
                class={`relative px-3 py-1.5 text-(length:--ds-font-caption) font-semibold tracking-(--ds-tracking-wide) uppercase transition-colors duration-(--ds-duration-fast) ${
                  isCurrentPage
                    ? "text-(--ds-brand)"
                    : "text-textColor hover:text-(--ds-brand)"
                }`}
                data-astro-prefetch
                href={linkPath}
              >
                {t(link.key)}
                {isCurrentPage && (
                  <div class="absolute bottom-0 left-3 right-3 h-0.5 bg-(--ds-brand)" />
                )}
              </a>
            );
          })
        }
      </nav>
      <!-- Right Side Actions -->
      <div class="flex items-center space-x-3">
        <!-- Desktop Action Buttons -->
        <div id="buttons-panel" class="hidden md:flex items-center space-x-2">
          <OramaSearch />
          <AIChatbot />
          <LanguageToggle />
          <ThemeToggle />
        </div>

        <!-- Mobile Action Buttons -->
        <div class="flex md:hidden items-center space-x-2 relative z-40">
          <OramaSearch />
          <AIChatbot />
          <LanguageToggle />
          <ThemeToggle />
        </div>

        <!-- Mobile Menu Button -->
        <mobile-button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="Open main menu"
          class="group relative h-10 w-10 rounded-lg bg-special/50 hover:bg-special transition-all duration-200 text-accent-base md:hidden"
          id="toggle-nav-menu-mobile"
          type="button"
        >
          <Icon
            id="open-nav-menu-icon"
            aria-hidden="true"
            class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all duration-200"
            focusable="false"
            name="hugeicons:menu-01"
          />
          <Icon
            id="close-nav-menu-icon"
            aria-hidden="true"
            class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all duration-200"
            focusable="false"
            name="hugeicons:cancel-01"
          />
        </mobile-button>
      </div>
    </div>
  </div>
</header>

<div id="drawer" class="fixed inset-0 z-40 hidden" aria-hidden="true">
  <div
    id="drawer-body"
    class="absolute inset-0 -translate-y-full transform bg-bgColor/95 backdrop-blur-md transition-all duration-300 ease-in-out"
  >

    <!-- Close button for mobile menu -->
    <button
      id="close-mobile-menu"
      class="absolute top-4 right-4 p-2 rounded-lg text-accent-base hover:bg-color-100 transition-colors z-50"
      aria-label="Close menu"
    >
      <Icon class="h-6 w-6" name="hugeicons:cancel-01" />
    </button>

    <nav
      aria-label="Mobile navigation menu"
      class="absolute inset-0 flex flex-col items-center justify-center gap-y-6 text-center pt-16"
      id="nav-menu-mobile"
    >
      <!-- Mobile Navigation Links -->
      {
        menuLinks.map((link) => {
          const linkPath = `/${currentLang}${link.path}`;
          const isCurrentPage =
            Astro.url.pathname === linkPath ||
            (link.path === "/" &&
              (Astro.url.pathname === `/${currentLang}` ||
                Astro.url.pathname === `/${currentLang}/`));

          return (
            <a
              aria-current={isCurrentPage ? "page" : false}
              class="text-(length:--ds-font-subhead) font-semibold tracking-(--ds-tracking-wide) uppercase text-textColor hover:text-(--ds-brand) transition-colors"
              data-astro-prefetch
              href={linkPath}
            >
              {t(link.key)}
            </a>
          );
        })
      }

    </nav>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggleNavMenuMobileButton = document.getElementById(
      "toggle-nav-menu-mobile"
    );
    const openMenuIcon = document.getElementById("open-nav-menu-icon");
    const closeMenuIcon = document.getElementById("close-nav-menu-icon");
    const closeMobileMenuButton = document.getElementById("close-mobile-menu");
    const drawer = document.getElementById("drawer");

    // Проверяем существование элементов
    if (
      !toggleNavMenuMobileButton ||
      !openMenuIcon ||
      !closeMenuIcon ||
      !drawer
    ) {
      console.error("One or more required elements are missing in the DOM.");
      return;
    }

    const drawerBody = document.getElementById("drawer-body");
    if (!drawerBody) {
      console.error("Drawer body element is missing in the DOM.");
      return;
    }

    // Function to close the mobile menu
    const closeMobileMenu = () => {
      drawerBody.classList.add("opacity-0", "-translate-y-full");
      drawerBody.classList.remove("translate-y-0");

      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);

      // Reset icons
      openMenuIcon.classList.add("scale-100", "opacity-100");
      closeMenuIcon.classList.add("scale-0", "opacity-0");
      closeMenuIcon.classList.remove("scale-100", "opacity-100");

      // Update button state
      toggleNavMenuMobileButton.setAttribute("aria-expanded", "false");
    };

    // Add event listener for close button
    if (closeMobileMenuButton) {
      closeMobileMenuButton.addEventListener("click", closeMobileMenu);
      console.log("Close button event listener added");
    } else {
      console.error("Close mobile menu button not found");
    }

    toggleNavMenuMobileButton.addEventListener("click", () => {
      const isOpen =
        toggleNavMenuMobileButton.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMobileMenu();
      } else {
        // Показываем меню
        drawer.classList.remove("hidden");
        drawerBody.classList.add("translate-y-0");
        drawerBody.classList.remove("opacity-0", "-translate-y-full");

        // Меняем иконки
        openMenuIcon.classList.add("scale-0", "opacity-0");
        closeMenuIcon.classList.add("scale-100", "opacity-100");
        openMenuIcon.classList.remove("scale-100", "opacity-100");
        // Update button state
        toggleNavMenuMobileButton.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
