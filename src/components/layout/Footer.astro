---
import { menuLinks, siteConfig } from "@/site.config";
const year = new Date().getFullYear();

// Detect current language from URL
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith("/zh-TW") ? "zh-TW" : "en";

// Simple translation function
const translations = {
  en: {
    "navigation.home": "Home",
    "navigation.about": "About",
    "navigation.blog": "Blog",
    "navigation.notes": "Notes",
    "footer.copyright": `© ${year} ${siteConfig.title}. All rights reserved.`,
    "footer.tagline": "Exploring the intersection of technology and innovation",
    "footer.social": "Follow Us",
  },
  "zh-TW": {
    "navigation.home": "首頁",
    "navigation.about": "關於",
    "navigation.blog": "部落格",
    "navigation.notes": "筆記",
    "footer.copyright": `© ${year} ${siteConfig.title}。保留所有權利。`,
    "footer.tagline": "探索科技與創新的交匯點",
    "footer.social": "關注我們",
  },
};

const t = (key: string) => translations[currentLang][key] || key;
---

<footer class="mt-auto bg-special border-t border-special-lighter">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-4 md:grid-cols-2">
      <!-- Logo and Brand Section -->
      <div class="lg:col-span-2">
        <a
          aria-label={siteConfig.title}
          aria-current={Astro.url.pathname === "/" ||
          Astro.url.pathname === `/${currentLang}` ||
          Astro.url.pathname === `/${currentLang}/`
            ? "page"
            : false}
          class="group flex h-8 items-center hover:filter-none sm:relative mb-4"
          href={currentLang === "zh-TW" ? "/zh-TW" : "/en"}
        >
          <div title={siteConfig.title}>
            <img class="w-10 h-10" src="/brand.svg" alt="" />
          </div>

          <strong
            class="'max-[320px]:hidden' bg-clip-text text-transparent bg-gradient-to-r from-accent-one to-accent-two hidden xs:block z-10 mb-0.5 ms-2 text-xl group-hover:text-accent-one"
          >
            {siteConfig.title}
          </strong>
        </a>
        <p class="text-sm text-textColor/80 mb-6 max-w-md leading-relaxed">
          {t("footer.tagline")}
        </p>

        <!-- Social Links -->
        <div class="flex items-center space-x-4">
          <span class="text-sm font-medium text-textColor"
            >{t("footer.social")}:</span
          >
          <div class="flex space-x-3">
            <a
              href="/rss.xml"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-two transition-colors duration-200"
              aria-label="RSS Feed"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795 0 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <div>
        <h3 class="text-sm font-semibold text-accent-base mb-4">Navigation</h3>
        <ul class="space-y-3">
          {
            menuLinks.map((link) => {
              const linkPath =
                currentLang === "zh-TW"
                  ? `/zh-TW${link.path}`
                  : `/en${link.path}`;

              return (
                <li>
                  <a
                    class="text-sm text-textColor hover:text-accent-base transition-colors duration-200 hover:underline underline-offset-2"
                    href={linkPath}
                  >
                    {t(link.key)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- Additional Links -->
      <div>
        <h3 class="text-sm font-semibold text-accent-base mb-4">Resources</h3>
        <ul class="space-y-3">
          <li>
            <a
              href="/rss.xml"
              class="text-sm text-textColor hover:text-accent-base transition-colors duration-200 hover:underline underline-offset-2"
            >
              RSS Feed
            </a>
          </li>
          <li>
            <a
              href="/sitemap-index.xml"
              class="text-sm text-textColor hover:text-accent-base transition-colors duration-200 hover:underline underline-offset-2"
            >
              Sitemap
            </a>
          </li>
          <li>
            <a
              href="/tags"
              class="text-sm text-textColor hover:text-accent-base transition-colors duration-200 hover:underline underline-offset-2"
            >
              All Tags
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="mt-12 pt-8 border-t border-special-lighter">
      <div
        class="flex flex-col items-center justify-between space-y-4 md:flex-row md:space-y-0"
      >
        <p class="text-sm text-textColor/70">
          {t("footer.copyright")}
        </p>
      </div>
    </div>
  </div>
</footer>
