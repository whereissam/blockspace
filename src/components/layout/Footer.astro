---
import { siteConfig, menuLinks } from "@/site.config";

const year = new Date().getFullYear();

// Detect current language from URL
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith("/zh-TW")
	? "zh-TW"
	: currentPath.startsWith("/zh-CN")
		? "zh-CN"
		: "en";

// Simple translation function
const translations = {
	en: {
		"navigation.home": "Home",
		"navigation.about": "About",
		"navigation.blog": "Blog",
		"navigation.notes": "Notes",
		"footer.copyright": `© ${year} ${siteConfig.title}. All rights reserved.`,
		"footer.tagline": "Exploring the intersection of technology and innovation",
		"footer.social": "Follow Us",
	},
	"zh-TW": {
		"navigation.home": "首頁",
		"navigation.about": "關於",
		"navigation.blog": "部落格",
		"navigation.notes": "筆記",
		"footer.copyright": `© ${year} ${siteConfig.title}。保留所有權利。`,
		"footer.tagline": "探索科技與創新的交匯點",
		"footer.social": "關注我們",
	},
	"zh-CN": {
		"navigation.home": "首页",
		"navigation.about": "关于",
		"navigation.blog": "博客",
		"navigation.notes": "笔记",
		"footer.copyright": `© ${year} ${siteConfig.title}。保留所有权利。`,
		"footer.tagline": "探索科技与创新的交汇点",
		"footer.social": "关注我们",
	},
};

const t = (key: string) => (translations[currentLang] as Record<string, string>)[key] || key;
---

<footer class="mt-auto border-t border-color-150">
  <div class="mx-auto max-w-7xl px-4 py-(--ds-space-2xl) md:px-6 lg:px-8">
    <!-- Top: logo + nav in one row -->
    <div class="flex flex-col gap-(--ds-space-xl) md:flex-row md:items-start md:justify-between">
      <!-- Brand -->
      <div class="max-w-sm">
        <a
          aria-label={siteConfig.title}
          class="inline-flex items-center gap-2"
          href={currentLang === "en" ? "/en" : `/${currentLang}`}
        >
          <img class="w-8 h-8" src="/brand.svg" alt="" />
          <strong class="text-lg font-bold text-(--ds-brand)">
            {siteConfig.title}
          </strong>
        </a>
        <p class="ds-caption mt-(--ds-space-sm) max-w-xs">
          {t("footer.tagline")}
        </p>
      </div>

      <!-- Nav columns -->
      <div class="flex gap-(--ds-space-3xl)">
        <div>
          <h3 class="ds-tag mb-(--ds-space-md)">Navigation</h3>
          <ul class="space-y-2">
            {
              menuLinks.map((link) => (
                <li>
                  <a
                    class="ds-caption hover:text-(--ds-brand) transition-colors"
                    href={`/${currentLang}${link.path}`}
                  >
                    {t(link.key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="ds-tag mb-(--ds-space-md)">Resources</h3>
          <ul class="space-y-2">
            <li><a class="ds-caption hover:text-(--ds-brand) transition-colors" href="/rss.xml">RSS Feed</a></li>
            <li><a class="ds-caption hover:text-(--ds-brand) transition-colors" href="/sitemap-index.xml">Sitemap</a></li>
            <li><a class="ds-caption hover:text-(--ds-brand) transition-colors" href="/tags">All Tags</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="ds-divider mt-(--ds-space-xl)"></div>
    <p class="ds-caption mt-(--ds-space-md)">
      {t("footer.copyright")}
    </p>
  </div>
</footer>
