---
import type { CollectionEntry } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import PostList from "@/components/blog/PostList.astro";
import type { GetStaticPaths } from "astro";
import { getPostsByLanguage, getUniqueTags } from "@/data/post";
import { collectionDateSort } from "@/utils/date";

export const prerender = true;

export const getStaticPaths = (async () => {
	const allPosts = await getPostsByLanguage("zh-CN");
	const uniqueTags = getUniqueTags(allPosts).slice(0, 20);
	const sortedPosts = allPosts.sort(collectionDateSort);
	return [{ params: { page: undefined }, props: { posts: sortedPosts, uniqueTags } }];
}) satisfies GetStaticPaths;

if (Astro.params.page) {
	return Astro.redirect("/zh-CN/posts/");
}

let { posts, uniqueTags } = Astro.props as { posts?: CollectionEntry<"post">[]; uniqueTags?: string[] };
if (!posts || !posts.length) {
	const allPosts = await getPostsByLanguage("zh-CN");
	posts = allPosts.sort(collectionDateSort);
	uniqueTags = getUniqueTags(posts).slice(0, 20);
}
---

<PageLayout meta={{ title: "文章", description: "阅读我的文章集和我感興趣的事物" }}>
	<PostList
		posts={posts}
		uniqueTags={uniqueTags!}
		locale="zh-CN"
		title="文章"
		tagsTitle="标签"
		viewAllTagsLabel="查看全部 →"
		emptyTitle="简体中文内容即将推出"
		emptySubtitle="Simplified Chinese content coming soon"
		emptyDetail="目前所有内容都是英文，中文翻译正在进行中"
	/>
</PageLayout>
