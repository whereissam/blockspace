---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import PageLayout from "@/layouts/Base.astro";
import { getNotesByLanguage } from "@/data/post";
import { collectionDateSort } from "@/utils/date";
import { ui } from "@/i18n/ui";

const lang = "zh-CN";
const t = ui[lang];

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
	const allNotes = await getNotesByLanguage("zh-CN");
	if (allNotes.length === 0) {
		return [{ params: { page: undefined }, props: { page: { data: [], url: { prev: null, next: null }, currentPage: 1, lastPage: 1, size: 5, total: 0 } } }];
	}
	return paginate(allNotes.sort(collectionDateSort), { pageSize: 5 });
}) satisfies GetStaticPaths;

interface Props { page: Page<CollectionEntry<"note">>; }

const { page } = Astro.props;

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: t.prevPage, url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: t.nextPage, url: page.url.next } }),
};
---

<PageLayout meta={{ title: t.notesPageTitle, description: t.notesDescription }}>
  <section class="mt-12 mb-16">
    <h1 class="title mb-6 flex items-center gap-2">
      {t.notesPageTitle}
      <a class="text-accent-two" href={`/${lang}/notes/rss.xml`} target="_blank">
        <span class="sr-only">RSS feed</span>
        <Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
      </a>
    </h1>
    {page.data.length === 0 ? (
      <div class="text-center py-16">
        <h3 class="text-xl mb-4 text-textColor">{t.notesEmptyTitle}</h3>
        <p class="text-gray-500 mb-4">{t.notesEmptySubtitle}</p>
        <p class="text-sm text-gray-400">{t.notesEmptyDetail}</p>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {page.data.map((note) => (
            <div><Note note={note} as="h4" isPreview /></div>
          ))}
        </div>
        <Pagination {...paginationProps} />
      </>
    )}
  </section>
</PageLayout>
