---
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getPostsByLanguage, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Badge from "@/components/Badge.astro";

export const prerender = true;
export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 5;
	const MAX_TAGS = 20;
	const allPosts = await getPostsByLanguage('zh-TW');
	const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);
	
	// If no posts, create at least one empty page
	if (allPosts.length === 0) {
		return [{
			params: { page: undefined },
			props: { 
				page: {
					data: [],
					url: { prev: null, next: null },
					currentPage: 1,
					lastPage: 1,
					size: MAX_POSTS_PER_PAGE,
					total: 0
				},
				uniqueTags: []
			}
		}];
	}
	
	return paginate(allPosts.sort(collectionDateSort), {
		pageSize: MAX_POSTS_PER_PAGE,
		props: { uniqueTags },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props;

const meta = {
	description: "閱讀我的文章集和我感興趣的事物",
	title: "文章",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← 上一頁",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一頁 →",
			url: page.url.next,
		},
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<h1 class="title mb-6 flex items-center gap-2">
		文章
		<a class="text-accent-two" href="/zh-TW/rss.xml" target="_blank">
			<span class="sr-only">RSS 訂閱</span>
			<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
		</a>
	</h1>
	<div class="grid gap-y-8 sm:grid-cols-[1fr_auto] sm:gap-x-8">
		<section aria-label="部落格文章列表" class="grow">
			{page.data.length === 0 ? (
				<div class="text-center py-16">
					<h3 class="text-xl mb-4 text-textColor">繁體中文內容即將推出</h3>
					<p class="text-gray-500 mb-4">Traditional Chinese content coming soon</p>
					<p class="text-sm text-gray-400">目前所有內容都是英文，中文翻譯正在進行中</p>
				</div>
			) : (
				descYearKeys.map((yearKey) => (
					<>
						<h4 class="title">{yearKey}</h4>
						<ul class="mb-8 mt-4 space-y-8 text-start">
							{groupedByYear[yearKey]?.map((p) => (
								<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
									<PostPreview post={p} withDesc={true} />
								</li>
							))}
						</ul>
					</>
				))
			)}
		</section>
		{
			!!uniqueTags.length && (
				<aside class="md:min-w-[14rem] md:max-w-[14rem] md:basis-[14rem]">
					<h4 class="title mb-4 flex gap-2">
						標籤
					</h4>
					<ul class="flex flex-wrap gap-2">
						{uniqueTags.map((tag) => (
							<li>
								<a aria-label={`查看所有標籤為 ${tag} 的文章`} href={`/zh-TW/tags/${tag}`}>
									<Badge variant="muted" title={tag} />
								</a>
							</li>
						))}

						<span class="text-base ms-auto inline-flex items-center h-6 sm:text-end">
							<a
								aria-label="查看所有文章分類"
								class="font-medium text-accent sm:hover:text-accent-two"
								href="/zh-TW/tags/"
							>
								查看全部 →
							</a>
						</span>	
					</ul>
				</aside>
			)
		}
	</div>
	<Pagination {...paginationProps} />
</PageLayout>