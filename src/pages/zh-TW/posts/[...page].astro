---
import type { CollectionEntry } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import PostList from "@/components/blog/PostList.astro";
import type { GetStaticPaths } from "astro";
import { getPostsByLanguage, getUniqueTags } from "@/data/post";
import { collectionDateSort } from "@/utils/date";
import { ui } from "@/i18n/ui";

const lang = "zh-TW";
const t = ui[lang];

export const prerender = true;

export const getStaticPaths = (async () => {
	const allPosts = await getPostsByLanguage("zh-TW");
	const uniqueTags = getUniqueTags(allPosts).slice(0, 20);
	const sortedPosts = allPosts.sort(collectionDateSort);
	return [{ params: { page: undefined }, props: { posts: sortedPosts, uniqueTags } }];
}) satisfies GetStaticPaths;

if (Astro.params.page) {
	return Astro.redirect(`/${lang}/posts/`);
}

let { posts, uniqueTags } = Astro.props as { posts?: CollectionEntry<"post">[]; uniqueTags?: string[] };
if (!posts || !posts.length) {
	const allPosts = await getPostsByLanguage(lang);
	posts = allPosts.sort(collectionDateSort);
	uniqueTags = getUniqueTags(posts).slice(0, 20);
}
---

<PageLayout meta={{ title: t.postsTitle, description: t.postsDescription }}>
	<PostList
		posts={posts}
		uniqueTags={uniqueTags!}
		locale={lang}
		title={t.postsTitle}
		tagsTitle={t.tagsTitle}
		viewAllTagsLabel={t.viewAllTags}
		emptyTitle={t.emptyPostsTitle!}
		emptySubtitle={t.emptyPostsSubtitle!}
		emptyDetail={t.emptyPostsDetail!}
	/>
</PageLayout>
