---
import { type CollectionEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts } from "@/data/post";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];

const meta = {
	description: "所有文章",
	title: "文章",
};
---

<Base meta={meta}>
	<section>
		<h1 class="title mb-6">所有文章</h1>
		<p class="mb-8 text-textColor">
			探索我們關於區塊鏈、人工智慧和科技創新的文章。
		</p>
		<div class="space-y-6">
			{
				sortedPosts.map((post) => (
					<article class="grid gap-4 sm:grid-cols-[auto_1fr]">
						<PostPreview post={post} />
					</article>
				))
			}
		</div>
	</section>
</Base>