---
export const prerender = true;

import { getPostsByLanguage, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import Badge from "@/components/Badge.astro";

const allPosts = await getPostsByLanguage("en");
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: "Browse all topics and tags covered in Blockspace articles",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Tags</h1>
	{allTags.length === 0 ? (
		<div class="text-center py-16">
			<h3 class="text-xl mb-4 text-textColor">No tags yet</h3>
			<p class="text-gray-500">Tags will appear once posts are published</p>
		</div>
	) : (
		<div class="flex flex-wrap items-center gap-2">
			{
				allTags.map(([tag, val]) => (
				<div class="flex items-center gap-x-2">
					<a aria-label={`View all posts tagged ${tag}`} href={`/en/tags/${tag}/`}>
					<Badge variant="muted" title={tag}>
						<span class="text-xs font-normal">
							&nbsp;{val} posts
						</span>
					</Badge>
					</a>
				</div>
				))
			}
		</div>
	)}
</PageLayout>
