{
	"name": "blockspace",
	"version": "1.0.0",
	"private": false,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist --root-selector html",
		"preview": "netlify dev",
		"lint": "biome lint .",
		"format": "bun run format:code && bun run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/netlify": "^6.6.3",
		"@astrojs/rss": "^4.0.14",
		"@astrojs/sitemap": "^3.6.1",
		"@astrojs/tailwind": "^6.0.2",
		"@orama/orama": "^3.1.18",
		"@shikijs/transformers": "^3.21.0",
		"astro": "^5.16.7",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-seo": "^0.8.4",
		"cssnano": "^7.1.2",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"playwright": "^1.57.0",
		"rehype-external-links": "^3.0.0",
		"rehype-pretty-code": "^0.14.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "^0.18.3",
		"satori-html": "^0.3.2",
		"sharp": "^0.33.5",
		"strip-markdown": "^6.0.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@biomejs/biome": "^2.3.11",
		"@iconify-json/hugeicons": "^1.2.22",
		"@iconify-json/mdi": "^1.2.2",
		"@iconify-json/solar": "^1.2.5",
		"@pagefind/default-ui": "^1.4.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.19",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@vite-pwa/astro": "^1.2.0",
		"autoprefixer": "^10.4.23",
		"netlify-cli": "^23.13.3",
		"pagefind": "^1.4.0",
		"prettier": "^3.7.4",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"reading-time": "^1.5.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"sharp"
		]
	}
}
